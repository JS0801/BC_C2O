<?xml version="1.0"?><!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
	<head>
		<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
		<#if .locale == "zh_CN">
			<link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
		<#elseif .locale == "zh_TW">
			<link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
		<#elseif .locale == "ja_JP">
			<link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
		<#elseif .locale == "ko_KR">
			<link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
		<#elseif .locale == "th_TH">
			<link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
		</#if>
		<macrolist>
			<macro id="nlheader">
				<table class="header" style="width: 100%;">
  <tr>
    <td colspan="2" style="font-size:18pt; font-weight:bold; padding-bottom: 20px;">TAX INVOICE</td>
    <td style="width: 30%;" align = 'right'>
      <img src="${logoURL}" style="width:130px; height: 60px;"/>
    </td>
  </tr>
  <tr>
    <td width="50%">
      <b>${record.customername}</b><br/>${record.billaddress}</td>
    <td width="25%" >
      <table style="width:100%; font-size:10pt;">
        <tr>
          <td><b>Invoice Date</b><br/>${record.trandate}</td>
        </tr>
        <tr>
          <td><b>Invoice Number</b><br/>#${record.id}</td>
        </tr>
        <tr>
          <td><b>Customer Ref#</b><br/>${record.custrecord_cust_ref}</td>
        </tr>
        <tr>
          <td><b>Customer Contact</b><br/>${projectMan}</td>
        </tr>
        <tr>
          <td><b>Memo</b><br/>${record.memo}</td>
        </tr>
      </table>
    </td>
    <td width="25%" style=" font-size:10pt;">${subsidiary.mainaddress_text}</td>
  </tr>
</table>

			</macro>
		</macrolist>
		<style>
			* {
			<#if .locale == "zh_CN">
				font-family: NotoSans, NotoSansCJKsc, sans-serif;
			<#elseif .locale == "zh_TW">
				font-family: NotoSans, NotoSansCJKtc, sans-serif;
			<#elseif .locale == "ja_JP">
				font-family: NotoSans, NotoSansCJKjp, sans-serif;
			<#elseif .locale == "ko_KR">
				font-family: NotoSans, NotoSansCJKkr, sans-serif;
			<#elseif .locale == "th_TH">
				font-family: NotoSans, NotoSansThai, sans-serif;
			<#else>
				font-family: NotoSans, sans-serif;
			</#if>
			}
		</style>
	</head>
	<body header="nlheader" header-height="31%" padding="0.5in 0.5in 0.5in 0.5in" size="Letter">
	<table style="width: 100%; font-size: 9pt; border-collapse: collapse;" border="0">
  <thead>
    <tr>
      <th align="left" style="border-bottom: 1px solid #000;" ><b>Description</b></th>
      <th align="right" style="border-bottom: 1px solid #000;"><b>Unit Price</b></th>
      <th align="center" style="border-bottom: 1px solid #000;"><b>GST</b></th>
      <th align="right" style="border-bottom: 1px solid #000;"><b>GST Amount</b></th>
      <th align="right" style="border-bottom: 1px solid #000;"><b>Amount AUD</b></th>
    </tr>
  </thead>
  <#list item.result as item>
  <tr padding-top = "10px">
    <td style="border-bottom: 1px solid #eee;">${item.category}</td>
    <td style="border-bottom: 1px solid #eee;" align="right">${item.unitPrice}</td>
    <td style="border-bottom: 1px solid #eee;" align="center">${item.rate}%</td>
    <td style="border-bottom: 1px solid #eee;" align="right">${item.gstAmount}</td>
    <td style="border-bottom: 1px solid #eee;" align="right">${item.total}</td>
  </tr>
  </#list>

  <tr><td colspan="5"><br /></td></tr>

  <tr padding-top = "10px">
    <td colspan="4" align="right" >Subtotal</td>
    <td align="right">${itemtotal}</td>
  </tr>
  <tr padding-top = "10px">
    <td colspan="3"></td>
    <td align="right" style="border-bottom: 1px solid #000;">TOTAL GST</td>
    <td align="right" style="border-bottom: 1px solid #000;">${taxtotal}</td>
  </tr>
  <tr padding-top = "10px">
    <td colspan="4" align="right"><b>TOTAL AUD</b></td>
    <td align="right"><b>${total}</b></td>
  </tr>
</table>
<table style="width: 100%; margin-top: 40px;">
  <tr>
    <td colspan="2" style="font-size: 12pt; font-weight: bold; padding-bottom: 5px;">
      Due Date: ${record.duedate?string("dd MMM yyyy")}
    </td>
  </tr>
  <tr>
    <td colspan="2" style="font-size: 10pt; padding-bottom: 10px;">
      Payment Terms: ${record.terms}<br />
      Please email remittance advice to <a href="${subsidiary.custrecord_bc_remittance_email}">${subsidiary.custrecord_bc_remittance_email}</a>
    </td>
  </tr>
  <tr>
    <td colspan="2" style="font-size: 10pt; font-weight: bold; padding: 10px 0 5px 0;">
      PLEASE NOTE CHANGE IN BANK ACCOUNT DETAILS
    </td>
  </tr>
  <tr>
    <td colspan="2" style="font-size: 10pt; padding-bottom: 5px;">
      Payment must be made to the following bank account:
    </td>
  </tr>
  <tr>
    <td colspan="2" style="font-size: 10pt;">
      Account name: ${subsidiary.custrecord_bc_account_name}<br />
      Bank: ${subsidiary.custrecord_bc_bank}<br />
      BSB: ${subsidiary.custrecord_bc_bsb}<br />
      Account: ${subsidiary.custrecord_bc_acc_num}
    </td>
  </tr>
</table>

	</body>
</pdf>